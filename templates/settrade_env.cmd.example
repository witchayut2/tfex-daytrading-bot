@echo off
REM EXAMPLE ONLY — never commit real secrets.
set SETTRADE_APP_ID=YOUR_APP_ID
set SETTRADE_APP_SECRET=YOUR_APP_SECRET
set SETTRADE_BROKER_ID=023
set SETTRADE_APP_CODE=ALGO

if defined SETTRADE_APP_ID (echo APP_ID: PRESENT) else (echo APP_ID: MISSING)
if defined SETTRADE_APP_SECRET (echo APP_SECRET: PRESENT) else (echo APP_SECRET: MISSING)
if defined SETTRADE_BROKER_ID (echo BROKER_ID: PRESENT) else (echo BROKER_ID: MISSING)
if defined SETTRADE_APP_CODE (echo APP_CODE: PRESENT) else (echo APP_CODE: MISSING)
