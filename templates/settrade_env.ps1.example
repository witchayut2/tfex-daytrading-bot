# EXAMPLE ONLY — never commit real secrets.
$env:SETTRADE_APP_ID="YOUR_APP_ID"
$env:SETTRADE_APP_SECRET="YOUR_APP_SECRET"
$env:SETTRADE_BROKER_ID="023"
$env:SETTRADE_APP_CODE="ALGO"

if ($env:SETTRADE_APP_ID) { "APP_ID: PRESENT" } else { "APP_ID: MISSING" }
if ($env:SETTRADE_APP_SECRET) { "APP_SECRET: PRESENT" } else { "APP_SECRET: MISSING" }
if ($env:SETTRADE_BROKER_ID) { "BROKER_ID: PRESENT" } else { "BROKER_ID: MISSING" }
if ($env:SETTRADE_APP_CODE) { "APP_CODE: PRESENT" } else { "APP_CODE: MISSING" }
